# Copy to .env for running the gateway or Alembic outside Docker.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# Optional. A cloud provider is switched on only when its key is set.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OLLAMA_BASE_URL=http://localhost:11434
# MOCK_PROVIDER_ENABLED=true
# PROVIDER_TIMEOUT_SECONDS=30
# MAX_REQUEST_BYTES=1000000
# MODELS_FILE=config/models.toml
